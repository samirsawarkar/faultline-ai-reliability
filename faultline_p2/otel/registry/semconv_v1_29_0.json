{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "provenance": {
    "source_url": "https://github.com/open-telemetry/semantic-conventions/blob/v1.29.0/docs/gen-ai/gen-ai-spans.md",
    "semconv_version": "1.29.0",
    "transcription": true,
    "transcription_date": "2026-09-04",
    "transcription_note": "Hand-transcribed in this repository from OpenTelemetry Semantic Conventions v1.29.0 documentation; not fetched or attested directly from upstream registry artifacts.",
    "verification_pending": "Requires automated fetch and diff against upstream semconv YAML artifacts or cryptographic hash pinning."
  },
  "semconv_version": "1.29.0",
  "schema_url": "https://opentelemetry.io/schemas/1.29.0",
  "description": "OpenTelemetry Semantic Conventions for Generative AI Operations (v1.29.0)",
  "operations": {
    "invoke_agent": {
      "allowed_span_kinds": ["SPAN_KIND_INTERNAL", "SPAN_KIND_SERVER"],
      "parent_operation": null,
      "required_attributes": [
        "gen_ai.operation.name"
      ],
      "allowed_attributes": [
        "gen_ai.operation.name",
        "gen_ai.system",
        "gen_ai.agent.id",
        "gen_ai.agent.name"
      ]
    },
    "chat": {
      "allowed_span_kinds": ["SPAN_KIND_CLIENT", "SPAN_KIND_INTERNAL"],
      "parent_operation": "invoke_agent",
      "required_attributes": [
        "gen_ai.operation.name",
        "gen_ai.request.model"
      ],
      "allowed_attributes": [
        "gen_ai.operation.name",
        "gen_ai.system",
        "gen_ai.request.model",
        "gen_ai.request.temperature",
        "gen_ai.request.max_tokens",
        "gen_ai.usage.input_tokens",
        "gen_ai.usage.output_tokens",
        "gen_ai.response.id",
        "gen_ai.response.finish_reasons"
      ]
    },
    "execute_tool": {
      "allowed_span_kinds": ["SPAN_KIND_INTERNAL"],
      "parent_operation": "chat",
      "required_attributes": [
        "gen_ai.operation.name",
        "gen_ai.tool.name"
      ],
      "allowed_attributes": [
        "gen_ai.operation.name",
        "gen_ai.tool.name",
        "gen_ai.system",
        "gen_ai.tool.call_id",
        "gen_ai.tool.description"
      ]
    }
  },
  "attribute_types": {
    "gen_ai.operation.name": {
      "type": "string",
      "enum": ["chat", "text_completion", "generate_embeddings", "invoke_agent", "execute_tool"]
    },
    "gen_ai.system": {
      "type": "string"
    },
    "gen_ai.request.model": {
      "type": "string"
    },
    "gen_ai.request.temperature": {
      "type": "double"
    },
    "gen_ai.request.max_tokens": {
      "type": "int"
    },
    "gen_ai.usage.input_tokens": {
      "type": "int"
    },
    "gen_ai.usage.output_tokens": {
      "type": "int"
    },
    "gen_ai.tool.name": {
      "type": "string"
    },
    "gen_ai.agent.id": {
      "type": "string"
    },
    "gen_ai.agent.name": {
      "type": "string"
    },
    "gen_ai.tool.call_id": {
      "type": "string"
    },
    "gen_ai.tool.description": {
      "type": "string"
    }
  }
}
